    "journal": [
      {
        "title": "Dawn",
        "callout": "NOTE",
        "folded": false,
        "questions": [
          { "question": "What am I grateful for?", "hint": "Small things count too", "kind": "list" },
          { "question": "My current goal", "hint": "Where do I want to be in a year?", "kind": "text" },
          { "question": "The \"One Thing\"", "hint": "What would I do today even without pay?", "kind": "task" }
        ],
        "timing": { "due": { "from": "10:00", "to": "13:00" }, "openWhenDue": true, "openOn": [] }
      },
      {
        "title": "Dusk",
        "callout": "NOTE",
        "folded": false,
        "questions": [
          { "question": "Three things I'm proud of", "hint": "What went well?", "kind": "list" },
