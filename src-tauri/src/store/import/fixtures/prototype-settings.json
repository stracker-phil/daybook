{
  "vaultPath": "/Users/example/Vault",
  "hotkeys": {
    "switchActivity": "cmd+f2",
    "toggleStatus": "cmd+f1",
    "jiraOpen": "ctrl+alt+cmd+j",
    "journal": "ctrl+alt+cmd+n",
    "search": "ctrl+alt+cmd+f",
    "toggleRail": "f10",
    "hub": "alt+cmd+enter",
    "links": "ctrl+alt+cmd+l",
    "quickNotes": "cmd+f3",
    "switchContext": "alt+cmd+f1",
    "focus": "alt+cmd+f2",
    "music": "ctrl+cmd+m",
    "palette": "ctrl+cmd+k"
  },
  "obsidianCliPath": "",
  "jira": { "baseUrl": "https://example.atlassian.net/browse/", "defaultPrefix": "QRS" },
  "rail": {
    "enabled": true,
    "edges": "both",
    "showDuringMeetings": true,
    "callEdge": "right",
    "callPosition": "center",
    "triggerWidth": 6,
    "triggerSpan": "full",
    "showDelay": 200,
    "hideDelay": 700,
    "shape": "docked",
    "size": "regular",
    "theme": "dark",
    "highlight": "filled",
    "captions": false,
    "position": "pointer",
    "fadeWhenIdle": false,
    "tooltipDelay": 150,
    "hoverMenus": true
  },
  "dailyNote": {
    "activity": { "level": "##", "text": "Activity" },
    "journal": { "level": "##", "text": "Journal" },
    "focus": { "level": "##", "text": "Focus" },
    "plan": { "level": "##", "text": "Plan for Today" },
    "order": ["journal", "focus", "plan", "activity", "notes"]
  },
  "api": { "enabled": true, "port": 27180, "token": "fake-api-token-0123456789abcdef", "presentations": true },
  "meetingDetection": true,
  "slackChannel": "#team-updates",
  "config": {
    "vaultName": "Example Vault",
    "dailyNote": {
      "fallbackFolder": "1-Journal",
      "fallbackFormat": "YYYY-MM-DD",
      "sections": { "notes": "## Notes" }
    },
    "activityFormat": {
      "working": "_working_",
      "afk": "_afk_ {note}",
      "offNote": "off for today :wave:",
      "workingNote": "re",
      "firstWorkingNote": "good morning :wave:",
      "breakNote": "afk",
      "activity": "**{client}** ({activity})"
    },
    "timeline": { "firstHour": 0, "lastHour": 24 },
    "slack": {
      "working": { "keepStatus": false, "emoji": ":white_check_mark:", "text": "9:00 - 18:00", "presence": "auto" },
      "break": { "keepStatus": false, "emoji": ":negative_squared_cross_mark:", "text": "AFK", "presence": "away" },
      "off": { "keepStatus": false, "emoji": ":offline:", "text": "Day's done", "presence": "away" }
    },
    "manualWorkflows": { "working": true, "break": false, "off": true },
    "statusLogLines": { "working": true, "break": true, "off": true },
    "endOfDay": {
      "enabled": true,
      "reminder": "",
      "question": "Is today fully tracked?",
      "url": "https://example.com/timesheets",
      "done": "Tracked: Done | _{message}_",
      "incomplete": "Tracked: Incomplete | _{message}_"
    },
    "focus": { "enabled": true, "endOfDayTitle": "EOD" },
    "statusRules": {
      "rules": [
        {
          "hours": 8,
          "enabled": true,
          "slack": { "keepStatus": false, "emoji": ":warning:", "text": "Away later {when}", "presence": "keep" }
        },
        {
          "hours": 24,
          "enabled": true,
          "slack": { "keepStatus": false, "emoji": ":information_source:", "text": "Away {when}", "presence": "keep" }
        }
      ],
      "absenceTitles": ["Out of office"],
      "minBusyHours": 8,
      "tzLabel": ""
    },
    "meetings": [
      {
        "enabled": true,
        "app": "Zoom",
        "bundleId": "us.zoom.xos",
        "windowTitle": "Zoom Meeting",
        "slack": { "keepStatus": false, "emoji": ":spiral_calendar_pad:", "text": "In a Zoom Call", "presence": "auto" }
      },
      {
        "enabled": true,
        "app": "Meet",
        "bundleId": "com.google.Chrome.app.example",
        "windowTitle": null,
        "slack": { "keepStatus": false, "emoji": ":spiral_calendar_pad:", "text": "In a Google Meeting", "presence": "auto" }
      },
      {
        "enabled": true,
        "app": "Teams",
        "bundleId": "com.microsoft.teams2",
        "windowTitle": null,
        "slack": { "keepStatus": false, "emoji": ":spiral_calendar_pad:", "text": "In a Teams call", "presence": "auto" }
      }
    ],
    "joining": {
      "startFirst": [{ "app": "Camo", "bundleId": "com.reincubate.macos.cam" }],
      "openWith": {
        "Zoom": { "app": "zoom.us", "bundleId": "us.zoom.xos" },
        "Teams": { "app": "Microsoft Teams", "bundleId": "com.microsoft.teams2" },
        "Meet": { "app": "Google Meet", "bundleId": "com.google.Chrome.app.example" }
