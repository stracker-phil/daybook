    {
      "title": "Dawn",
      "callout": "NOTE",
      "folded": false,
      "questions": [
        {
          "question": "What am I grateful for?",
          "hint": "Small things count too",
          "kind": "list"
        },
        {
          "question": "My current goal",
          "hint": "Where do I want to be in a year?",
          "kind": "text"
        },
        {
          "question": "The \"One Thing\"",
