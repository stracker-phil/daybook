{
  "lightScheme": "default",
  "darkScheme": "dark",
  "accent": "system",
  "textSize": "medium",
  "launchAtLogin": false,
  "vault": {
    "path": null,
    "name": "Vault",
    "obsidianCliPath": ""
  },
  "dailyNote": {
    "fallbackFolder": "1-Journal",
    "fallbackFormat": "YYYY-MM-DD",
    "notes": "## Notes",
    "journal": {
      "level": "##",
      "text": "Journal"
    },
    "focus": {
      "level": "##",
      "text": "Focus"
    },
    "plan": {
      "level": "##",
      "text": "Plan for Today"
    },
    "order": [
      "journal",
      "focus",
      "plan",
      "notes"
    ]
  },
  "statusMessages": {
    "working": "re",
    "firstWorking": "",
    "break": "afk",
    "off": "off for today :wave:"
  },
  "slack": {
    "channel": "",
    "statuses": {
      "working": {
        "keepStatus": false,
        "emoji": ":white_check_mark:",
        "text": "9:00 - 18:00",
        "presence": "auto"
      },
      "break": {
        "keepStatus": false,
        "emoji": ":negative_squared_cross_mark:",
        "text": "AFK",
        "presence": "away"
      },
      "off": {
        "keepStatus": false,
        "emoji": ":offline:",
        "text": "Day's done",
        "presence": "away"
      }
    },
    "manualWorkflows": {
      "working": true,
      "break": true,
      "off": true
    }
  },
  "endOfDay": {
    "enabled": true,
    "reminder": "",
    "question": "Is today fully tracked?",
    "url": "https://example.com/timesheets",
    "done": "Tracked: Done | _{message}_",
    "incomplete": "Tracked: Incomplete | _{message}_"
  },
  "focus": {
    "enabled": true,
    "endOfDayTitle": "EOD"
  },
  "statusRules": {
    "rules": [
      {
        "hours": 8,
        "enabled": true,
        "slack": {
          "keepStatus": false,
          "emoji": ":information_source:",
          "text": "Away later {when}",
          "presence": "keep"
        }
      },
      {
        "hours": 168,
        "enabled": true,
        "slack": {
          "keepStatus": false,
          "emoji": ":warning:",
          "text": "Upcoming absence {when}",
          "presence": "keep"
        }
      }
    ],
    "absenceTitles": [
      "Out of office"
    ],
    "minBusyHours": 8.0,
    "tzLabel": ""
  },
  "timeline": {
    "firstHour": 0,
    "lastHour": 24
  },
  "meetings": {
    "detection": true,
    "rules": [
      {
        "enabled": true,
        "app": "Zoom",
        "bundleId": "us.zoom.xos",
        "windowTitle": null,
        "slack": {
          "keepStatus": false,
          "emoji": ":spiral_calendar_pad:",
          "text": "In a Zoom call",
          "presence": "auto"
        }
      },
      {
        "enabled": true,
        "app": "Teams",
        "bundleId": "com.microsoft.teams2",
        "windowTitle": null,
        "slack": {
          "keepStatus": false,
          "emoji": ":spiral_calendar_pad:",
          "text": "In a Teams call",
          "presence": "auto"
        }
      },
      {
        "enabled": true,
        "app": "Meet",
        "bundleId": "com.google.Chrome.app.kjgfgldnnfoeklkmfkjfagphfepbbdan",
        "windowTitle": null,
        "slack": {
          "keepStatus": false,
          "emoji": ":spiral_calendar_pad:",
          "text": "In a Google Meet call",
          "presence": "auto"
        }
      }
    ]
  },
  "joining": {
    "startFirst": [
      {
        "app": "Camo",
        "bundleId": "com.reincubate.macos.cam"
      }
    ],
    "openWith": {
      "Zoom": null,
      "Teams": null,
      "Meet": {
        "app": "Google Meet",
        "bundleId": "com.google.Chrome.app.kjgfgldnnfoeklkmfkjfagphfepbbdan"
